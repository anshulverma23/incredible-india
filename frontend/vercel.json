{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://YOUR-BACKEND-URL/api/seo/sitemap.xml"
    },
    {
      "source": "/hotels/:slug",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/hotels/:slug"
    },
    {
      "source": "/packages/:slug",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/packages/:slug"
    },
    {
      "source": "/destinations/:slug",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/destinations/:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/blog/:slug"
    },
    {
      "source": "/hotels",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/hotels"
    },
    {
      "source": "/packages",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/packages"
    },
    {
      "source": "/destinations",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/destinations"
    },
    {
      "source": "/blog",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/blog"
    },
    {
      "source": "/about",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/about"
    },
    {
      "source": "/faq",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/faq"
    },
    {
      "source": "/contact",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/contact"
    },
    {
      "source": "/plan-trip",
      "destination": "https://YOUR-BACKEND-URL/api/seo/page?path=/plan-trip"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
