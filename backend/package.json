{
  "name": "india-travel-backend",
  "version": "2.0.0",
  "description": "Backend API for India Travel booking platform (Node.js + Express + MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "seed": "node utils/seedData.js",
    "migrate:roles": "node scripts/migrate-roles.js",
    "migrate:slugs": "node scripts/backfill-package-slug.js",
    "migrate:hotel-slugs": "node scripts/generate-hotel-slug.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.15.1",
    "razorpay": "^2.9.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "utils/**/*.js",
      "middlewares/**/*.js",
      "validators/**/*.js",
      "!utils/seedData.js"
    ]
  }
}
